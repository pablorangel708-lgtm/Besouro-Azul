local fxFolder = create("Folder", { Name = "BeetleFX_Local", Parent = Workspace })

local function mkPart(size, color, material, transparency)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.Transparency = transparency or 0
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function weld(base, part, c0, parent)
	part.CFrame = base.CFrame * c0
	local w = Instance.new("Weld")
	w.Part0 = base
	w.Part1 = part
	w.C0 = c0
	w.Parent = part
	part.Parent = parent
	return w
end

local function makeSparks(parent, color)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color or COLORS.Cyan, COLORS.White)
	e.LightEmission = 1
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.3, 0.7)
	e.Speed = NumberRange.new(6, 16)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Parent = parent
	return e
end

local function rayFilter()
	local list = { fxFolder }
	if character then table.insert(list, character) end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true


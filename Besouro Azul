local ACCENTS = {
	["á"] = "a", ["à"] = "a", ["â"] = "a", ["ã"] = "a", ["ä"] = "a",
	["é"] = "e", ["è"] = "e", ["ê"] = "e", ["ë"] = "e",
	["í"] = "i", ["ì"] = "i", ["î"] = "i", ["ï"] = "i",
	["ó"] = "o", ["ò"] = "o", ["ô"] = "o", ["õ"] = "o", ["ö"] = "o",
	["ú"] = "u", ["ù"] = "u", ["û"] = "u", ["ü"] = "u",
	["ç"] = "c",
	["Á"] = "a", ["À"] = "a", ["Â"] = "a", ["Ã"] = "a", ["Ä"] = "a",
	["É"] = "e", ["È"] = "e", ["Ê"] = "e", ["Ë"] = "e",
	["Í"] = "i", ["Ì"] = "i", ["Î"] = "i", ["Ï"] = "i",
	["Ó"] = "o", ["Ò"] = "o", ["Ô"] = "o", ["Õ"] = "o", ["Ö"] = "o",
	["Ú"] = "u", ["Ù"] = "u", ["Û"] = "u", ["Ü"] = "u",
	["Ç"] = "c",
}

local function normalize(text)
	text = string.lower(text)
	for from, to in pairs(ACCENTS) do
		text = string.gsub(text, from, to)
	end
	text = string.gsub(text, "[^%a%d]", "")
	text = string.gsub(text, "dobesouroazul$", "")
	text = string.gsub(text, "besouroazul$", "")
	return text
end


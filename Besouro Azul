	local tw = tween(c.nv, 0.4, { Value = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local function cleanup()
		c.nv:Destroy()
		for _, p in ipairs(c.parts) do
			if p.Parent then p:Destroy() end
		end
	end
	if tw then
		tw.Completed:Connect(cleanup)
	else
		cleanup()
	end
end


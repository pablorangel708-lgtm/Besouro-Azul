	ring.Size = Vector3.new(0.12, 1, 1)
	ring.Color = COLORS.White
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.1
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.CFrame = CFrame.lookAt(pos + normal * 0.05, pos + normal) * CFrame.Angles(0, math.rad(90), 0)
	ring.Parent = fxFolder
	tween(ring, 0.35, { Size = Vector3.new(0.12, 9, 9), Transparency = 1 })

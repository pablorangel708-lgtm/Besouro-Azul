local nvSaved = nil
local nvToken = 0

local function applyNight(on, instant)
	nvToken += 1
	local token = nvToken
	local dur = instant and 0 or 0.6
	if on then
		nvSaved = nvSaved or {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Exposure = Lighting.ExposureCompensation,
		}
		nvEffects.cc.Enabled = true
		nvEffects.bloom.Enabled = true
		nvRoot.Visible = true
		tween(nvEffects.cc, dur, {
			Brightness = 0.12,
			Contrast = 0.35,
			Saturation = -0.55,
			TintColor = Color3.fromRGB(120, 255, 185),
		})
		tween(nvEffects.bloom, dur, { Intensity = 0.9, Threshold = 0.7 })
		tween(Lighting, dur, {
			Ambient = Color3.fromRGB(95, 150, 125),
			OutdoorAmbient = Color3.fromRGB(95, 150, 125),
			ExposureCompensation = nvSaved.Exposure + 0.9,
		})
		nvFlash.BackgroundTransparency = 0.25
		tween(nvFlash, 0.5, { BackgroundTransparency = 1 })
	else
		if nvSaved then
			local s = nvSaved
			nvSaved = nil
			tween(Lighting, dur, {
				Ambient = s.Ambient,
				OutdoorAmbient = s.OutdoorAmbient,
				ExposureCompensation = s.Exposure,
			})
		end
		tween(nvEffects.cc, dur, {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
			TintColor = Color3.new(1, 1, 1),
		})
		tween(nvEffects.bloom, dur, { Intensity = 0, Threshold = 2 })
		if not instant then
			nvFlash.BackgroundTransparency = 0.45
			tween(nvFlash, 0.4, { BackgroundTransparency = 1 })
		end
		local function finish()
			if token == nvToken then
				nvEffects.cc.Enabled = false
				nvEffects.bloom.Enabled = false
				nvRoot.Visible = false
			end
		end
		if instant then finish() else task.delay(dur + 0.05, finish) end
	end
end


local function updateThreats(t)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local camCF = cam.CFrame
	local camPos = camCF.Position
	local view = cam.ViewportSize
	local center = view / 2
	local halfW = math.max(40, view.X / 2 - 56)
	local halfH = math.max(40, view.Y / 2 - 60)

	local look = camCF.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) else flat = flat.Unit end
	local right = flat:Cross(Vector3.yAxis)

	local doText = (t - lastTextUpdate) > 0.12
	if doText then lastTextUpdate = t end

	local origin = rootPart and rootPart.Position or camPos
	local seen = {}
	local count, nearest = 0, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local dist = (hrp.Position - origin).Magnitude
				if dist <= CONFIG.ThreatRange then
					seen[plr] = true
					count += 1
					if dist < nearest then nearest = dist end

					local m = markers[plr] or createMarker(plr)
					local meters = dist * CONFIG.StudsToMeters
					local band, color = bandFor(meters)
					if m.band ~= band then
						m.band = band
						m.stroke.Color = color
						m.dot.BackgroundColor3 = color
						m.arrow.TextColor3 = color
						m.distLabel.TextColor3 = color
						m.radarDot.BackgroundColor3 = color
					end
					ensureHighlight(m, char)

					-- posição na tela
					local vp, onScreen = cam:WorldToViewportPoint(hrp.Position)
					local pos
					if onScreen then
						pos = Vector2.new(vp.X, vp.Y)
						m.diamond.Visible = true
						m.dot.Visible = true
						m.arrow.Visible = false
					else
						local rel = camCF:PointToObjectSpace(hrp.Position)
						local dir = Vector2.new(rel.X, -rel.Y)
						if dir.Magnitude < 0.001 then dir = Vector2.new(0, 1) end
						dir = dir.Unit
						local sx = dir.X ~= 0 and halfW / math.abs(dir.X) or math.huge
						local sy = dir.Y ~= 0 and halfH / math.abs(dir.Y) or math.huge
						pos = center + dir * math.min(sx, sy)
						m.diamond.Visible = false
						m.dot.Visible = false
						m.arrow.Visible = true
						m.arrow.Rotation = math.deg(math.atan2(dir.X, -dir.Y))
					end
					m.frame.Position = UDim2.fromOffset(pos.X, pos.Y)
					m.frame.Visible = true

					if doText then
						m.distLabel.Text = string.format("%dm", math.floor(meters + 0.5))
						m.nameLabel.Text = plr.DisplayName
					end

					-- radar
					local delta = hrp.Position - camPos
					local v = Vector2.new(delta:Dot(right), -delta:Dot(flat)) / CONFIG.RadarRange
					if v.Magnitude > 1 then v = v.Unit end
					local r = RADAR_SIZE / 2 - 5
					m.radarDot.Position = UDim2.new(0.5, v.X * r, 0.5, v.Y * r)
				end
			end
		end
	end

	for plr in pairs(markers) do
		if not seen[plr] then destroyMarker(plr) end
	end

	if doText then
		if count > 0 then
			local nm = nearest * CONFIG.StudsToMeters
			targetsLabel.Text = string.format("ALVOS: %d | PERTO: %dm", count, math.floor(nm + 0.5))
			targetsLabel.TextColor3 = nm < 35 and COLORS.Threat or COLORS.Text
			if nm < 15 and t - lastAlert > 5 then
				lastAlert = t
				addLog("ALERTA: ALVO PRÓXIMO", COLORS.Threat)
				headerStroke.Color = COLORS.Threat
				tween(headerStroke, 0.8, { Color = COLORS.Cyan })
			end
		else
			targetsLabel.Text = "ALVOS: 0"
			targetsLabel.TextColor3 = COLORS.Text
		end
	end
end


local buttons = {}
local function makeButton(key, text, order, accent, callback)
	local b = create("TextButton", {
		Name = key,
		LayoutOrder = order,
		AutoButtonColor = false,
		BackgroundColor3 = COLORS.Deep,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Text = text,
		TextColor3 = COLORS.Text,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		Parent = buttonRow,
	})
	addCorner(b, UDim.new(0, 5))
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 3),
		PaddingRight = UDim.new(0, 3),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = b,
	})
	create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 6, Parent = b })
	local stroke = addStroke(b, COLORS.Cyan, 1.2, 0.35)
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -3),
		Size = UDim2.new(0.7, 0, 0, 3),
		BackgroundColor3 = accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = b,
	})
	addCorner(bar, UDim.new(1, 0))
	b.Activated:Connect(callback)
	buttons[key] = { button = b, stroke = stroke, bar = bar, accent = accent }
end

setButtonState = function(key, on)
	local b = buttons[key]
	if not b then return end
	tween(b.button, 0.2, {
		BackgroundColor3 = on and b.accent or COLORS.Deep,
		BackgroundTransparency = on and 0.55 or 0.25,
	})
	tween(b.stroke, 0.2, { Color = on and b.accent or COLORS.Cyan, Transparency = on and 0 or 0.35 })
	tween(b.bar, 0.2, { BackgroundTransparency = on and 0 or 1 })
end


local function makeVignette(parent, color, strength)
	local holder = create("Frame", {
		Name = "Vignette",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	local function edge(size, pos, anchor, rot)
		local f = create("Frame", {
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Size = size,
			Position = pos,
			AnchorPoint = anchor,
			Parent = holder,
		})
		create("UIGradient", {
			Rotation = rot,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, strength),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = f,
		})
	end
	edge(UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0), Vector2.new(0, 0), 90)
	edge(UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270)
	edge(UDim2.fromScale(0.22, 1), UDim2.fromScale(0, 0), Vector2.new(0, 0), 0)
	edge(UDim2.fromScale(0.22, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180)
	return holder
end

local function makeScanlines(parent, count, transparency, color)
	local holder = create("Frame", {
		Name = "Scanlines",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	for i = 0, count - 1 do
		create("Frame", {
			BackgroundColor3 = color,
			BackgroundTransparency = transparency,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromScale(0, i / count),
			Parent = holder,
		})
	end
	return holder
end


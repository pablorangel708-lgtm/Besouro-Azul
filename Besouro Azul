local logCount = 0
addLog = function(text, color)
	if not state.mask then return end
	logCount += 1
	local l = label(logFrame, {
		Text = "> " .. text,
		Size = UDim2.new(1, 0, 0, 14),
		TextColor3 = color or COLORS.Cyan,
		TextSize = 11,
		Font = Enum.Font.Code,
		LayoutOrder = logCount,
		TextTransparency = 1,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	tween(l, 0.25, { TextTransparency = 0 })
	local lines = {}
	for _, c in ipairs(logFrame:GetChildren()) do
		if c:IsA("TextLabel") then table.insert(lines, c) end
	end
	table.sort(lines, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	while #lines > 5 do
		lines[1]:Destroy()
		table.remove(lines, 1)
	end
	task.delay(6, function()
		if l.Parent then tween(l, 1, { TextTransparency = 0.6 }) end
	end)
end


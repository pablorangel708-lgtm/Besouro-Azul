local function buildBlade(side)
	local m = getMount(side)
	if not m then return nil end
	local arm, sign, y = m.part, m.sign, m.yOff
	local parent = ARMOR.folder or character
	local x = sign * (arm.Size.X / 2 + 0.16)
	local zStart = -(arm.Size.Z / 2) + 0.3
	local H = 0.5
	local bodyColor = Color3.fromRGB(18, 44, 110)

	local parts = {}
	local function reg(p) table.insert(parts, p) return p end

	local mount = reg(mkPart(Vector3.new(0.3, 0.62, 0.62), COLORS.Armor2, Enum.Material.Metal))
	weld(arm, mount, CFrame.new(x, y, zStart + 0.05), parent)

	local body = reg(mkPart(Vector3.new(0.12, H, 0.1), bodyColor, Enum.Material.Metal))
	local wBody = weld(arm, body, CFrame.new(x, y, zStart), parent)

	local stripTop = reg(mkPart(Vector3.new(0.14, 0.05, 0.1), COLORS.Cyan, Enum.Material.Neon))
	local wTop = weld(arm, stripTop, CFrame.new(x, y + H / 2 - 0.02, zStart), parent)

	local stripBot = reg(mkPart(Vector3.new(0.14, 0.05, 0.1), COLORS.Cyan, Enum.Material.Neon))
	local wBot = weld(arm, stripBot, CFrame.new(x, y - H / 2 + 0.02, zStart), parent)

	local core = reg(mkPart(Vector3.new(0.15, 0.09, 0.1), COLORS.White, Enum.Material.Neon, 0.15))
	local wCore = weld(arm, core, CFrame.new(x, y, zStart), parent)

	local tip = reg(mkPart(Vector3.new(0.12, 0.3536, 0.3536), bodyColor, Enum.Material.Metal))
	local wTip = weld(arm, tip, CFrame.new(x, y, zStart) * CFrame.Angles(math.rad(45), 0, 0), parent)

	local light = Instance.new("PointLight")
	light.Color = COLORS.Cyan
	light.Range = 9
	light.Brightness = 2
	light.Parent = core

	local sparks = makeSparks(tip, COLORS.Cyan)

	local function update(e)
		local L = math.max(0.06, CONFIG.BladeLength * e)
		local cz = zStart - L / 2
		body.Size = Vector3.new(0.12, H, L)
		wBody.C0 = CFrame.new(x, y, cz)
		stripTop.Size = Vector3.new(0.14, 0.05, L)
		wTop.C0 = CFrame.new(x, y + H / 2 - 0.02, cz)
		stripBot.Size = Vector3.new(0.14, 0.05, L)
		wBot.C0 = CFrame.new(x, y - H / 2 + 0.02, cz)
		core.Size = Vector3.new(0.15, 0.09, math.max(0.04, L * 0.9))
		wCore.C0 = CFrame.new(x, y, cz)
		wTip.C0 = CFrame.new(x, y, zStart - L) * CFrame.Angles(math.rad(45), 0, 0)
	end

	local nv = Instance.new("NumberValue")
	nv.Value = 0
	nv.Changed:Connect(update)
	update(0)

	return { parts = parts, nv = nv, sparks = sparks, update = update }
end

local function extendBlade(b)
	b.nv.Value = 0
	tween(b.nv, 0.5, { Value = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	b.sparks:Emit(24)
end

local function retractBlade(b)
	b.sparks:Emit(14)
	local tw = tween(b.nv, 0.35, { Value = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local function cleanup()
		b.nv:Destroy()
		for _, p in ipairs(b.parts) do
			if p.Parent then p:Destroy() end
		end
	end
	if tw then
		tw.Completed:Connect(cleanup)
	else
		cleanup()
	end
end


local function spawnProjectile(origin, dir)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.9, 0.9, 0.9)
	p.Color = COLORS.Cyan
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.CFrame = CFrame.lookAt(origin, origin + dir)

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.35, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.35, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.28
	trail.Color = ColorSequence.new(COLORS.Cyan, COLORS.Blue)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = p

	local light = Instance.new("PointLight")
	light.Color = COLORS.Cyan
	light.Range = 10
	light.Brightness = 3
	light.Parent = p

	p.Parent = fxFolder
	table.insert(projectiles, { part = p, dir = dir, born = os.clock() })
end

local function updateProjectiles(dt)
	if #projectiles == 0 then return end
	rayParams.FilterDescendantsInstances = rayFilter()
	local now = os.clock()
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local part = pr.part
		if not part.Parent then
			table.remove(projectiles, i)
		else
			local step = pr.dir * CONFIG.ProjectileSpeed * dt
			local pos = part.Position
			local hit = Workspace:Raycast(pos, step + pr.dir * 0.6, rayParams)
			if hit then
				impactFx(hit.Position, hit.Normal)
				part:Destroy()
				table.remove(projectiles, i)
			elseif now - pr.born > CONFIG.ProjectileLifetime then
				part:Destroy()
				table.remove(projectiles, i)
			else
				local np = pos + step
				part.CFrame = CFrame.lookAt(np, np + pr.dir)
			end
		end
	end
end

local shotIndex = 0
local function fireOnce()
	if not state.cannons then return end
	local cam = Workspace.CurrentCamera
	if not cam then return end

	local list = {}
	for _, side in ipairs({ "right", "left" }) do
		local c = cannons[side]
		if c and c.ready and c.core.Parent then table.insert(list, c) end
	end
	if #list == 0 then return end

	rayParams.FilterDescendantsInstances = rayFilter()
	local origin = cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local res = Workspace:Raycast(origin, look * CONFIG.MaxRayDistance, rayParams)
	local target = res and res.Position or (origin + look * CONFIG.MaxRayDistance)

	shotIndex = shotIndex % #list + 1
	local c = list[shotIndex]
	local muzzle = c.core.Position
	local dir = target - muzzle
	if dir.Magnitude < 1 then dir = look else dir = dir.Unit end

	muzzleFlash(muzzle)
	spawnProjectile(muzzle + dir * 0.4, dir)
	energyDip = 0.1
end

local function fireBurst(n)
	task.spawn(function()
		for _ = 1, n do
			if not state.cannons then break end
			fireOnce()
			task.wait(CONFIG.FireInterval)
		end
	end)
end


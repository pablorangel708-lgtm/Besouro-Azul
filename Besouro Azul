local function buildCannon(side)
	local m = getMount(side)
	if not m then return nil end
	local arm, y = m.part, m.yOff
	local parent = ARMOR.folder or character
	local zBase = -(arm.Size.Z / 2)
	local rot = CFrame.Angles(0, math.rad(90), 0) -- eixo X do cilindro → eixo Z (frente)
	local parts = {}
	local function reg(p) table.insert(parts, p) return p end

	local housing = reg(mkPart(Vector3.new(0.64, 0.64, 0.5), COLORS.Armor2, Enum.Material.Metal))
	weld(arm, housing, CFrame.new(0, y, zBase - 0.02), parent)

	local barrel = reg(mkPart(Vector3.new(0.1, 0.42, 0.42), COLORS.Armor, Enum.Material.Metal))
	barrel.Shape = Enum.PartType.Cylinder
	local wBarrel = weld(arm, barrel, CFrame.new(0, y, zBase) * rot, parent)

	local fractions = { 0.3, 0.6, 0.88 }
	local ringWelds = {}
	for i = 1, #fractions do
		local ring = reg(mkPart(Vector3.new(0.07, 0.54, 0.54), COLORS.Cyan, Enum.Material.Neon))
		ring.Shape = Enum.PartType.Cylinder
		ringWelds[i] = weld(arm, ring, CFrame.new(0, y, zBase) * rot, parent)
	end

	local muzzleRing = reg(mkPart(Vector3.new(0.14, 0.62, 0.62), COLORS.Armor2, Enum.Material.Metal))
	muzzleRing.Shape = Enum.PartType.Cylinder
	local wMuzzle = weld(arm, muzzleRing, CFrame.new(0, y, zBase) * rot, parent)

	local core = reg(mkPart(Vector3.new(0.3, 0.3, 0.3), COLORS.White, Enum.Material.Neon))
	core.Shape = Enum.PartType.Ball
	local wCore = weld(arm, core, CFrame.new(0, y, zBase), parent)

	local light = Instance.new("PointLight")
	light.Color = COLORS.Cyan
	light.Range = 10
	light.Brightness = 2.5
	light.Parent = core

	local obj = { parts = parts, core = core, ready = false, side = side }

	local function update(e)
		local Lb = math.max(0.1, CONFIG.CannonLength * e)
		local z0 = zBase + 0.1
		barrel.Size = Vector3.new(Lb, 0.42, 0.42)
		wBarrel.C0 = CFrame.new(0, y, z0 - Lb / 2) * rot
		for i, f in ipairs(fractions) do
			ringWelds[i].C0 = CFrame.new(0, y, z0 - Lb * f) * rot
		end
		wMuzzle.C0 = CFrame.new(0, y, z0 - Lb) * rot
		wCore.C0 = CFrame.new(0, y, z0 - Lb - 0.08)
		obj.ready = e > 0.85
	end

	local nv = Instance.new("NumberValue")
	nv.Value = 0
	nv.Changed:Connect(update)
	update(0)
	obj.nv = nv
	return obj
end

local function extendCannon(c)
	c.nv.Value = 0
	tween(c.nv, 0.6, { Value = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function retractCannon(c)

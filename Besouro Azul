local lastCmd, lastCmdTime = "", 0
local function onChat(message)
	if type(message) ~= "string" or message == "" then return end
	local key = normalize(message)
	local handler = COMMANDS[key]
	if not handler then return end
	local now = os.clock()
	if key == lastCmd and now - lastCmdTime < 0.5 then return end -- evita duplicidade (chat legado + novo)
	lastCmd, lastCmdTime = key, now
	task.spawn(handler)
end


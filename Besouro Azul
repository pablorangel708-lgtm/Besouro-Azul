local ARMOR = { folder = nil, parts = {} }
local blades = {}
local cannons = {}

local function getMount(side)
	if not character then return nil end
	local names = side == "right" and { "RightLowerArm", "Right Arm" } or { "LeftLowerArm", "Left Arm" }
	for _, n in ipairs(names) do
		local p = character:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			local r6 = (n == "Right Arm" or n == "Left Arm")
			return {
				part = p,
				r6 = r6,
				yOff = r6 and -0.45 or 0.05,
				sign = side == "right" and 1 or -1,
			}
		end
	end
	return nil
end

local function addArmorPart(part, baseTransparency)
	table.insert(ARMOR.parts, { part = part, tr = baseTransparency or 0 })
	part.Transparency = 1
end

local function buildArmor()
	if ARMOR.folder or not character then return end
	local folder = Instance.new("Folder")
	folder.Name = "BeetleArmor"
	folder.Parent = character
	ARMOR.folder = folder
	ARMOR.parts = {}

	-- Capacete + olhos
	local head = character:FindFirstChild("Head")
	if CONFIG.Helmet and head then
		local shell = mkPart(Vector3.new(1.6, 1.6, 1.6), COLORS.Armor, Enum.Material.Metal)
		shell.Shape = Enum.PartType.Ball
		weld(head, shell, CFrame.new(0, 0.05, 0), folder)
		addArmorPart(shell, 0)

		local crest = mkPart(Vector3.new(0.12, 0.1, 1.1), COLORS.Cyan, Enum.Material.Neon)
		weld(head, crest, CFrame.new(0, 0.82, 0.05), folder)
		addArmorPart(crest, 0)

		for s = -1, 1, 2 do
			local eye = mkPart(Vector3.new(0.36, 0.09, 0.12), COLORS.White, Enum.Material.Neon)
			weld(head, eye, CFrame.new(s * 0.27, 0.1, -0.74) * CFrame.Angles(0, 0, math.rad(-s * 18)), folder)
			addArmorPart(eye, 0)
		end
	end

	-- Peitoral + escaravelho
	local chest = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if chest then
		local zF = -(chest.Size.Z / 2)
		local cy = chest.Size.Y * 0.12
		local plate = mkPart(Vector3.new(chest.Size.X * 0.95, chest.Size.Y * 0.6, 0.18), COLORS.Armor, Enum.Material.Metal)
		weld(chest, plate, CFrame.new(0, cy, zF - 0.06), folder)
		addArmorPart(plate, 0)

		local core = mkPart(Vector3.new(0.42, 0.42, 0.1), COLORS.Cyan, Enum.Material.Neon)
		weld(chest, core, CFrame.new(0, cy, zF - 0.19) * CFrame.Angles(0, 0, math.rad(45)), folder)
		addArmorPart(core, 0)

		for s = -1, 1, 2 do
			local wing = mkPart(Vector3.new(0.5, 0.07, 0.08), COLORS.Cyan, Enum.Material.Neon)
			weld(chest, wing, CFrame.new(s * 0.55, cy + 0.05, zF - 0.17) * CFrame.Angles(0, 0, math.rad(-s * 20)), folder)
			addArmorPart(wing, 0)
		end
	end

	-- Braceletes
	for _, side in ipairs({ "right", "left" }) do
		local m = getMount(side)
		if m then
			local arm = m.part
			local h = m.r6 and 1.1 or arm.Size.Y * 0.9
			local shell = mkPart(Vector3.new(arm.Size.X + 0.2, h, arm.Size.Z + 0.2), COLORS.Armor, Enum.Material.Metal)
			weld(arm, shell, CFrame.new(0, m.yOff, 0), folder)
			addArmorPart(shell, 0)
			for _, sy in ipairs({ 1, -1 }) do
				local stripe = mkPart(Vector3.new(arm.Size.X + 0.23, 0.07, arm.Size.Z + 0.23), COLORS.Cyan, Enum.Material.Neon)
				weld(arm, stripe, CFrame.new(0, m.yOff + sy * (h / 2 - 0.1), 0), folder)
				addArmorPart(stripe, 0)
			end
		end
	end

	-- Fade-in escalonado
	for i, rec in ipairs(ARMOR.parts) do
		task.delay(i * 0.03, function()
			if rec.part.Parent then
				tween(rec.part, 0.45, { Transparency = rec.tr })
			end
		end)
	end

	-- Anel de varredura subindo pelo corpo
	if rootPart then
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.15, 5.5, 5.5)
		ring.Color = COLORS.Cyan
		ring.Material = Enum.Material.Neon
		ring.Transparency = 0.2
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanTouch = false
		ring.CanQuery = false
		ring.CastShadow = false
		local base = CFrame.new(rootPart.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
		ring.CFrame = base
		ring.Parent = fxFolder
		tween(ring, 0.8, {
			CFrame = CFrame.new(rootPart.Position + Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Transparency = 0.9,
		}, Enum.EasingStyle.Sine)
		Debris:AddItem(ring, 1)
	end
end

local function removeArmor()
	local folder = ARMOR.folder
	if not folder then return end
	local parts = ARMOR.parts
	ARMOR.folder = nil
	ARMOR.parts = {}
	for _, rec in ipairs(parts) do
		if rec.part.Parent then
			tween(rec.part, 0.35, { Transparency = 1 })
		end
	end
	task.delay(0.5, function()
		if folder.Parent then folder:Destroy() end
	end)
end


local lastEnergy = 0

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()

	-- Visão noturna: varredura + cintilação
	if state.night then
		nvSweep.Position = UDim2.fromScale(0, ((t * 0.45) % 1.3) - 0.14)
		nvRoot.Tint.BackgroundTransparency = 0.91 + math.random() * 0.04
	end

	if not state.mask then return end

	-- Mira girando
	reticleSpinner.Rotation = (t * 40) % 360
	radarSweep.Rotation = (t * 150) % 360

	-- Barra de energia (decorativa)
	energyDip = math.max(0, energyDip - dt * 0.35)
	if t - lastEnergy > 0.08 then
		lastEnergy = t
		local v = 0.9 + 0.07 * math.sin(t * 1.7) + 0.02 * math.sin(t * 9.3) - energyDip
		v = math.clamp(v, 0.05, 1)
		energyFill.Size = UDim2.fromScale(v, 1)
		energyPct.Text = string.format("%d%%", math.floor(v * 100))
	end
	energyGradient.Offset = Vector2.new(math.sin(t * 1.6) * 0.35, 0)

	-- Scanner de ameaças
	if state.threats then
		updateThreats(t)
	end

	-- Canhões: pulso do núcleo + disparo contínuo
	if state.cannons then
		for _, c in pairs(cannons) do
			if c.ready and c.core.Parent then
				local s = 0.3 + 0.07 * math.sin(t * 8)
				c.core.Size = Vector3.new(s, s, s)
			end
		end
		if firePointerInput and firePointerInput.UserInputState == Enum.UserInputState.End then
			firing = false
			firePointerInput = nil
		end
		if (firing or mouseHeld) and t - lastShot >= CONFIG.FireInterval then
			lastShot = t
			fireOnce()
		end
	end
end)

